# Copiar a .env.local y completar cuando exista el proyecto de Supabase.
# Mientras estas variables no estén seteadas, el sitio funciona igual
# usando los datos de referencia de lib/seed-data.ts (sin base de datos).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo se usa en el servidor (server actions del panel admin). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
